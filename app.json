{
  "expo": {
    "name": "Le Sommelier IA",
    "slug": "sommelier-ia",
    "owner": "frdo1",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sommelier",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.frdo1.sommelieria",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#771D1D"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'appli accède à vos photos pour analyser une étiquette de vin.",
          "cameraPermission": "L'appli utilise l'appareil photo pour photographier les étiquettes de vin.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8906338773802694~6278116158",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "serverUrl": "https://application-vin.vercel.app/api/sommelier",
      "router": {},
      "eas": {
        "projectId": "81d55090-680b-484b-8e28-e7fcf1892624"
      }
    }
  }
}
